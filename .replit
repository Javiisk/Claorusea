modules = ["nodejs-18"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[userenv]

[userenv.shared]
AUTO_MIGRATE = "true"
BACKUP_DIR = "./backups"
BACKUP_RETENTION_DAYS = "14"
CORS_ORIGIN = "*"
LOG_LEVEL = "warn"
LOG_TO_FILE = "false"
NODE_ENV = "production"
PORT = "3000"
PORT_RETRY_ATTEMPTS = "5"
POSTGRES_BACKOFF_BASE = "100"
POSTGRES_BACKOFF_MULTIPLIER = "2"
POSTGRES_CONNECTION_TIMEOUT = "10000"
POSTGRES_IDLE_TIMEOUT = "30000"
POSTGRES_MAX_CONNECTIONS = "20"
POSTGRES_MIGRATION_TABLE = "schema_migrations"
POSTGRES_MIN_CONNECTIONS = "2"
POSTGRES_RETRIES = "3"
SCHEMA_VERSION = "1"
SCHEMA_VERSION_LABEL = "baseline-v1"
WEB_HOST = "0.0.0.0"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm start"

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 3000
externalPort = 80

[deployment]
deploymentTarget = "cloudrun"
