// src/commands/Roblox/eligibles.js
import {
  SlashCommandBuilder,
  EmbedBuilder,
  PermissionFlagsBits,
} from 'discord.js';
import { getAllUsers } from '../../utils/activityStorage.js';
import { getRobloxUsernameById, getRobloxGroupRank } from '../../utils/bloxlink.js';

// GMT-6 weekly reset — Monday 00:00 GMT-6
const RESET_DAY = 0;        // Sunday in GMT-6 = Monday 00:00 (offset)
const RESET_HOUR = 0;       // Midnight
const GMT_OFFSET = -6;      // GMT-6

function getWeekStart() {
  const now = new Date();
  const gmt6 = new Date(now.getTime() + GMT_OFFSET * 60 * 60 * 1000);

  // Get the most recent Sunday 00:00 GMT-6 (which is Monday 00:00 local)
  const daysBack = gmt6.getUTCDay(); // 0=Sunday
  const weekStart = new Date(gmt6);
  weekStart.setUTCDate(gmt6.getUTCDate() - daysBack);
  weekStart.setUTCHours(RESET_HOUR, 0, 0, 0);

  return weekStart.getTime();
}

function formatTime(minutes) {
  const h = Math.floor(minutes / 60);
  const m = Math.floor(minutes % 60);
  return `${h}h ${m}m`;
}

export default {
  data: new SlashCommandBuilder()
    .setName('eligibles')
    .setDescription('Show eligible members for promotion, demotion, or SOTW')
    .setDMPermission(false)
    .addStringOption(opt =>
      opt.setName('type')
        .setDescription('Type of eligibility list')
        .setRequired(true)
        .addChoices(
          { name: '⬆️ Promotion (30+ min)', value: 'promotion' },
          { name: '⬇️ Demotion (under 30 min)', value: 'demotion' },
          { name: '🏆 SOTW (top shifter)', value: 'sotw' },
        ))
    .setDefaultMemberPermissions(PermissionFlagsBits.ManageGuild),

  async execute(interaction) {
    await interaction.deferReply();

    const type = interaction.options.getString('type');
    const weekStart = getWeekStart();
    const allUsers = getAllUsers();

    // ─── Build user list ───────────────────────────────────────────────
    const users = [];

    for (const [discordId, data] of Object.entries(allUsers)) {
      if (!data.weeklyMinutes || data.weeklyMinutes <= 0) continue;
      if (data.lastReset && data.lastReset < weekStart) continue; // skip old data

      // Resolve Roblox username + rank
      let robloxName = 'Unknown';
      let rank = 'N/A';

      try {
        const { getRobloxUserByDiscord } = await import('../../utils/bloxlink.js');
        const bloxlinkData = await getRobloxUserByDiscord(discordId);
        if (bloxlinkData?.robloxID) {
          const username = await getRobloxUsernameById(bloxlinkData.robloxID);
          const groupRank = await getRobloxGroupRank(bloxlinkData.robloxID);
          if (username) robloxName = username;
          if (groupRank) rank = groupRank;
        }
      } catch (err) {
        // ignore, keep defaults
      }

      users.push({
        discordId,
        robloxName,
        rank,
        minutes: data.weeklyMinutes,
      });
    }

    if (users.length === 0) {
      return interaction.editReply({
        content: '❌ No activity recorded this week yet.',
      });
    }

    // ─── Sort & filter based on type ───────────────────────────────────
    let title = '';
    let filtered = [];
    let color = 0x5865F2;

    if (type === 'promotion') {
      title = '⬆️ Eligible for Promotion (30+ min this week)';
      filtered = users
        .filter(u => u.minutes >= 30)
        .sort((a, b) => b.minutes - a.minutes);
      color = 0x57F287;
    } else if (type === 'demotion') {
      title = '⬇️ Eligible for Demotion (under 30 min this week)';
      filtered = users
        .filter(u => u.minutes < 30)
        .sort((a, b) => a.minutes - b.minutes);
      color = 0xED4245;
    } else if (type === 'sotw') {
      title = '🏆 Shifter of the Week';
      const top = users.sort((a, b) => b.minutes - a.minutes)[0];
      filtered = [top];
      color = 0xFFD700;
    }

    if (filtered.length === 0) {
      return interaction.editReply({
        content: `❌ No users match the **${type}** criteria this week.`,
      });
    }

    // ─── Format output ─────────────────────────────────────────────────
    const lines = filtered.map((u, i) => {
      const rankEmoji = type === 'sotw' ? '👑' : `#${i + 1}`;
      return `${rankEmoji} **${u.robloxName}** — \`${u.rank}\` — **${formatTime(u.minutes)}**`;
    });

    // Discord embed description limit is 4096 — split if needed
    const description = lines.join('\n').slice(0, 4000);

    const resetTimestamp = Math.floor((weekStart + 7 * 24 * 60 * 60 * 1000) / 1000);

    const embed = new EmbedBuilder()
      .setColor(color)
      .setTitle(title)
      .setDescription(description)
      .setFooter({ text: `Resets every Monday 00:00 GMT-6 • Next: ` })
      .setTimestamp(resetTimestamp * 1000);

    await interaction.editReply({ embeds: [embed] });
  },
};