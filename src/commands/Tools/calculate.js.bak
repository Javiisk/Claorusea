import { SlashCommandBuilder } from 'discord.js';
import { createEmbed } from '../../utils/embeds.js';
import { logger } from '../../utils/logger.js';
import { InteractionHelper } from '../../utils/interactionHelper.js';

export default {
    data: new SlashCommandBuilder()
        .setName('calculate')
        .setDescription('🧮 Evaluate a mathematical expression')
        .addStringOption(option =>
            option
                .setName('expression')
                .setDescription('Mathematical expression (e.g., 2+2*3, 10/2, 5^2)')
                .setRequired(true)
        ),

    async execute(interaction) {
        const deferSuccess = await InteractionHelper.safeDefer(interaction);
        if (!deferSuccess) {
            logger.warn('Calculate defer failed', {
                userId: interaction.user.id,
                commandName: 'calculate'
            });
            return;
        }

        try {
            const expression = interaction.options.getString('expression');
            
            // Validar que solo contenga caracteres permitidos
            const allowedChars = /^[0-9+\-*/.()^% ]+$/;
            if (!allowedChars.test(expression)) {
                return await InteractionHelper.safeEditReply(interaction, {
                    content: '❌ Invalid expression. Use only numbers and operators (+, -, *, /, ^, %, parentheses).',
                });
            }

            // Evaluar expresión de forma segura
            let result;
            try {
                // Reemplazar ^ por ** para potencia
                const sanitized = expression.replace(/\^/g, '**');
                result = Function(`"use strict"; return (${sanitized})`)();
                
                if (typeof result !== 'number' || !isFinite(result)) {
                    throw new Error('Invalid result');
                }
            } catch {
                return await InteractionHelper.safeEditReply(interaction, {
                    content: '❌ Invalid expression. Please check the syntax and try again.',
                });
            }

            // Formatear resultado
            let formattedResult;
            if (Number.isInteger(result)) {
                formattedResult = result.toString();
            } else {
                formattedResult = result.toLocaleString('en-US', {
                    maximumFractionDigits: 10,
                });
            }

            const embed = createEmbed({
                title: '🧮 Calculation Result',
                description: `**Expression:** \`${expression}\`\n**Result:** \`${formattedResult}\``
            })
            .setColor(0x5865F2)
            .setTimestamp();

            await InteractionHelper.safeEditReply(interaction, { embeds: [embed] });

        } catch (error) {
            logger.error('Calculate error:', error);
            await InteractionHelper.safeReply(interaction, {
                content: '❌ An error occurred while calculating.',
            });
        }
    },
};
