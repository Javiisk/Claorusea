import { SlashCommandBuilder } from 'discord.js';
import { createEmbed } from '../../utils/embeds.js';
import { logger } from '../../utils/logger.js';
import { InteractionHelper } from '../../utils/interactionHelper.js';

export default {
    data: new SlashCommandBuilder()
        .setName('baseconvert')
        .setDescription('🔄 Convert a number between bases (2-36)')
        .addStringOption(option =>
            option
                .setName('number')
                .setDescription('Number to convert')
                .setRequired(true)
        )
        .addStringOption(option =>
            option
                .setName('from_base')
                .setDescription('Base to convert from (2-36)')
                .setRequired(true)
        )
        .addStringOption(option =>
            option
                .setName('to_base')
                .setDescription('Base to convert to (2-36)')
                .setRequired(true)
        ),

    async execute(interaction) {
        const deferSuccess = await InteractionHelper.safeDefer(interaction);
        if (!deferSuccess) {
            logger.warn('BaseConvert defer failed', {
                userId: interaction.user.id,
                commandName: 'baseconvert'
            });
            return;
        }

        try {
            const number = interaction.options.getString('number');
            const fromBase = parseInt(interaction.options.getString('from_base'));
            const toBase = parseInt(interaction.options.getString('to_base'));

            // Validar bases
            if (fromBase < 2 || fromBase > 36 || toBase < 2 || toBase > 36) {
                return await InteractionHelper.safeEditReply(interaction, {
                    content: '❌ Bases must be between 2 and 36.',
                });
            }

            // Convertir a decimal
            const decimal = parseInt(number, fromBase);
            if (isNaN(decimal)) {
                return await InteractionHelper.safeEditReply(interaction, {
                    content: `❌ Invalid number for base ${fromBase}.`,
                });
            }

            // Convertir a la base destino
            const result = decimal.toString(toBase).toUpperCase();

            const embed = createEmbed({
                title: '🔄 Base Conversion',
                description: `**${number}** (base ${fromBase}) → **${result}** (base ${toBase})`
            })
            .addFields(
                { name: 'Decimal', value: `\`${decimal}\``, inline: true },
                { name: 'Result', value: `\`${result}\``, inline: true }
            )
            .setColor(0x5865F2)
            .setTimestamp();

            await InteractionHelper.safeEditReply(interaction, { embeds: [embed] });

        } catch (error) {
            logger.error('BaseConvert error:', error);
            await InteractionHelper.safeReply(interaction, {
                content: '❌ An error occurred while converting.',
            });
        }
    },
};
